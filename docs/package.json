{
  "name": "ferroni",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-site-data.mjs && ardo dev",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "sample:write": "node scripts/render-regex-sample.mjs",
    "sample:check": "node scripts/render-regex-sample.mjs --check",
    "build": "node scripts/write-site-data.mjs && pnpm check:numbers && ardo build && pnpm check:links && node scripts/verify-build.mjs",
    "check:numbers": "node scripts/check-benchmark-claims.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --config oxlint.config.ts .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "ardo preview",
    "typecheck": "node scripts/write-site-data.mjs && tsc --noEmit",
    "check:links": "node scripts/check-site-links.mjs"
  },
  "dependencies": {
    "ardo": "^6.0.0",
    "ferramenta-family": "github:sebastian-software/ferramenta#9028b7134b3b70e385b06c8e59aa08a2df0d8271&path:/packages/family"
  },
  "devDependencies": {
    "@sebastian-software/standards": "0.13.0",
    "eslint": "^10.12.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
