{
  "name": "ferroni",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "sample:write": "node scripts/render-regex-sample.mjs",
    "sample:check": "node scripts/render-regex-sample.mjs --check",
    "build": "pnpm check:numbers && react-router build",
    "check:numbers": "node scripts/check-benchmark-claims.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --config oxlint.config.ts .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ardo": "^5.0.0",
    "ferramenta-family": "^2.0.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@sebastian-software/standards": "0.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
