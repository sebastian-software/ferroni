{
  "name": "ferroni",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "verify": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "sample:write": "node scripts/render-regex-sample.mjs",
    "sample:check": "node scripts/render-regex-sample.mjs --check",
    "build": "pnpm check:numbers && react-router build && pnpm check:links",
    "check:numbers": "node scripts/check-benchmark-claims.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint --config oxlint.config.ts .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-site-links.mjs"
  },
  "dependencies": {
    "ardo": "^5.0.0",
    "ferramenta-family": "^2.0.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@sebastian-software/standards": "0.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
