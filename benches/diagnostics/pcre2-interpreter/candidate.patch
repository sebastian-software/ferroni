+                                        region.end[..region.num_regs as usize].to_vec(),
+                                    )
+                                });
+                                (result, captures)
+                            };
+                            assert_eq!(
+                                run(false),
+                                run(true),
+                                "{text:?}, match={retry}, search={search}, stack={stack}, option={option:?}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
