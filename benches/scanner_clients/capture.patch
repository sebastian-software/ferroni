+fn trace_event(event: serde_json::Value) {
+    if let Ok(path) = std::env::var("FERRONI_CLIENT_TRACE") {
+        use std::io::Write;
+        let mut file = std::fs::OpenOptions::new().append(true).create(true).open(path).unwrap();
+        writeln!(file, "{event}").unwrap();
+    }
+}
+impl Drop for Scanner {
+    fn drop(&mut self) { if self.trace_scanner_id != 0 { trace_event(serde_json::json!({"kind":"drop", "scanner":self.trace_scanner_id})); } }
+}
