+// ---- Diagnostic trace capture (Ferroni's benches/json_scanner/capture.patch) ----
+// Every scanner call is appended as one JSON line to the file named by the
+// FERRIKI_TRACE environment variable, in the layout of
+// benches/cpp_scanner/capture.patch in Ferroni: scanner id, its pattern list
+// as handed to Ferroni, the subject's identity and content, the UTF-16 start,
+// the option bits, Ferroni's raw result and the elapsed time of the call.
+static NEXT_TRACE_SCANNER_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+static NEXT_TRACE_SUBJECT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+
+std::thread_local! {
+    /// OnigString address -> identity, registered where Ferriki creates one.
+    static TRACE_SUBJECTS: std::cell::RefCell<std::collections::HashMap<usize, u64>> =
+        std::cell::RefCell::new(std::collections::HashMap::new());
+}
+
+/// Registers a freshly created `OnigString`: a new identity for its address,
+/// replacing whatever previously lived there.
+pub(crate) fn trace_register(string: &OnigString) {
+    let id = NEXT_TRACE_SUBJECT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    TRACE_SUBJECTS.with(|map| {
+        map.borrow_mut()
+            .insert(string as *const OnigString as usize, id);
+    });
+}
+
+fn trace_subject_id(string: &OnigString) -> u64 {
+    TRACE_SUBJECTS.with(|map| {
+        *map.borrow_mut()
+            .entry(string as *const OnigString as usize)
+            .or_insert_with(|| {
+                NEXT_TRACE_SUBJECT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
+            })
+    })
+}
+
